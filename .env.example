# Copy to .env and fill in. Never commit .env.

# Extraction (api/lib/noa/extraction)
OPENAI_API_KEY=
# Model and reasoning effort for extraction. Defaults match Tulpa v1.
NOA_MODEL=gpt-5.6-luna
NOA_EFFORT=low

# API (api/), production values; dev uses config/dev.exs
DATABASE_URL=ecto://postgres:postgres@localhost/noa_dev
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:4000
# Email through Google Workspace SMTP (same as Tulpa v1). With an app password, invites,
# sign-in links and notifications are really sent; From is the SMTP user unless MAIL_FROM is set.
GOOGLE_APP_PASSWORD=
MAIL_SMTP_USERNAME=itsupport@notyouridea.com
MAIL_FROM=
MAIL_FROM_NAME=Noa
MAIL_FROM_EMAIL=no-reply@example.com
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
# FalkorDB. Leave empty to run the API without the graph.
FALKORDB_URL=redis://127.0.0.1:6379

# WhatsApp through Kapso. Leave the key empty to keep messages in the local outbox.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Approved Utility templates, English (US), body {{1}}. Needed outside the 24-hour window.
KAPSO_TEMPLATE_UPDATE=noa_update
KAPSO_TEMPLATE_TASK=noa_task
KAPSO_TEMPLATE_APPROVAL=noa_approval
KAPSO_TEMPLATE_LANG=en_US

# GitHub (3.7): Noa's GitHub App. Companies install it from Settings → Connectors.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Gmail inbox ingest (1.29). Start from current UIDNEXT; no historical backfill.
# Opt-in explicitly, after creating the workspace; never commit the Google app password.
GMAIL_IMAP_ENABLED=false
GMAIL_ORG_ID=
GMAIL_IMAP_USERNAME=itsupport@notyouridea.com
GMAIL_IMAP_PASSWORD=

# Discord (1.13): Noa's bot. Org admins connect their own server in Settings → Connectors.
# DISCORD_GUILD_ID and DISCORD_ORG_ID are only a fallback for a single-company install.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ORG_ID=

# Slack (1.14): one Slack app, installed separately by each workspace through OAuth.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# New non-Marketplace apps are limited to 15 history messages per request.
SLACK_HISTORY_LIMIT=15

# Web (web/)
NEXT_PUBLIC_API_URL=http://localhost:4000
