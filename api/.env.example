# Copy this file to api/.env. The start-gmail.ps1 helper loads it before starting Phoenix.
# Never commit api/.env or share the app password.
GMAIL_IMAP_ENABLED=true
GMAIL_ORG_ID=YOUR_WORKSPACE_UUID
GMAIL_IMAP_USERNAME=itsupport@notyouridea.com
GMAIL_IMAP_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
# Optional: proposals require an OpenAI key. Without it, emails are ingested but not extracted.
OPENAI_API_KEY=
