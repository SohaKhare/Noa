# Noa production settings for deploy/docker-compose.prod.yml. Copy to deploy/prod.env
# (gitignored) and fill in. On Fly, set the same values with `fly secrets set`.

# Hosts (same parent domain). DNS A/AAAA records must point at the server.
LANDING_HOST=noa.notyouridea.com
APP_HOST=app.notyouridea.com
API_HOST=api.notyouridea.com

# Generate each with: openssl rand -base64 48
POSTGRES_PASSWORD=
FALKORDB_PASSWORD=
SECRET_KEY_BASE=
TOKEN_SIGNING_SECRET=

# Email (invites, magic links, resets). Without a key, emails are written to the API log.
MAIL_FROM_NAME=Noa
MAIL_FROM_EMAIL=noa@notyouridea.com
RESEND_API_KEY=

# Extraction and @noa answers. Without a key Noa answers extractively and does not extract.
OPENAI_API_KEY=

# WhatsApp through Kapso. Webhook: https://API_HOST/webhooks/kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_TEMPLATE_UPDATE=noa_update
KAPSO_TEMPLATE_TASK=noa_task
KAPSO_TEMPLATE_APPROVAL=noa_approval
KAPSO_TEMPLATE_LANG=en_US

# Discord ingest. Leave the token empty to keep Discord off.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ORG_ID=

# Slack OAuth + Events API. Callback: https://API_HOST/slack/oauth/callback
# Request URL: https://API_HOST/webhooks/slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_HISTORY_LIMIT=15
